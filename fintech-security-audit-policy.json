{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSecurityConfigurationAudit",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketPolicy"
      ],
      "Resource": "arn:aws:s3:::fintech-dev-backups"
    }
  ]
}
