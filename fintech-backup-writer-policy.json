
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBackupUploadAndVerification",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::fintech-dev-backups/*"
    }
  ]
}

